{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Admin UI",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/admin-ui/src"
        },
        {
            "name": "Customer App",
            "request": "launch",
            "type": "dart",
            "cwd": "${workspaceFolder}/frontend-Customer",
            "program": "lib/main.dart",
            "deviceId": "chrome",
            "args": [
                "--web-port=3001"
            ]
        },
        {
            "name": "Driver App",
            "request": "launch",
            "type": "dart",
            "cwd": "${workspaceFolder}/frontend_Driver",
            "program": "lib/main.dart",
            "deviceId": "chrome",
            "args": [
                "--web-port=3002"
            ]
        }
    ]
}

PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/taximeter?retryWrites=true&w=majority
MONGO_URI_TEST=mongodb+srv://<user>:<password>@cluster0.mongodb.net/taximeter_test?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Used by scripts/seedAdmin.js (run once to create the first admin account)
ADMIN_EMAIL=admin@taximeter.com
ADMIN_PASSWORD=replace_with_strong_password
ADMIN_NAME=Admin
ADMIN_PHONE=0000000000

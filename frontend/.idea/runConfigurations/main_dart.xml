      child: ListTile(
        onTap: onTap,
        leading: Icon(icon, color: const Color(0xFF2563EB)),
        title: Text(title, style: const TextStyle(fontWeight: FontWeight.bold)),
        subtitle: Text(sub),
        trailing: const Icon(Icons.arrow_forward_ios, size: 16),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text("RideX"),
      ),
      body: Padding(
        padding: const EdgeInsets.all(16),
        child: Column(
          children: [
            homeCard(
              context,
              Icons.qr_code_scanner,
              "Scan Driver QR",
              "Scan government verified QR",
              () {
                Navigator.push(
                  context,
                  MaterialPageRoute(builder: (_) => const DriverScreen()),
                );
              },
            ),
            homeCard(
              context,
              Icons.search,
              "Search Nearby Drivers",
              "Find drivers around your area",
              () {},
            ),
            homeCard(
              context,
              Icons.receipt_long,
              "My Trips",
              "View previous trips",
              () {},
            ),
            homeCard(
              context,
              Icons.person,
              "Profile",
              "Manage your account",
              () {},
            ),
          ],
        ),
      ),
    );
  }
}

